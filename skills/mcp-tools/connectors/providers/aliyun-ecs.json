{
  "schemaVersion": 1,
  "id": "aliyun-ecs",
  "name": "阿里云 ECS",
  "category": "云服务",
  "description": "阿里云 ECS 通用连接器（ACS3 签名 签名，只读）：列区域、列实例、列系统镜像。支持 STS 临时令牌。不提供任意云 API 透传。",
  "runtimeKind": "aliyun-ecs",
  "officialDocs": [
    "https://help.aliyun.com/zh/ecs/developer-reference/api-ecs-2014-05-26-describeregions",
    "https://help.aliyun.com/zh/ecs/developer-reference/api-ecs-2014-05-26-describeinstances",
    "https://help.aliyun.com/zh/ecs/developer-reference/api-ecs-2014-05-26-describeimages",
    "https://help.aliyun.com/zh/sdk/product-overview/rpc-mechanism",
    "https://www.alibabacloud.com/help/en/sdk/product-overview/rpc-mechanism"
  ],
  "authDocs": [
    "https://help.aliyun.com/zh/sdk/product-overview/sts-token"
  ],
  "baseUrl": "https://ecs.{ALIYUN_REGION}.aliyuncs.com",
  "fields": [
    {
      "key": "ALIYUN_REGION",
      "label": "区域 ID（如 cn-hangzhou、ap-southeast-1）",
      "secret": false,
      "required": true,
      "pattern": "^[a-z]{2}(?:-[a-z0-9]+){1,4}$",
      "example": "cn-hangzhou"
    },
    {
      "key": "ALIYUN_ACCESS_KEY_ID",
      "label": "AccessKey ID",
      "secret": false,
      "required": true,
      "pattern": "^\\S{8,4096}$",
      "example": ""
    },
    {
      "key": "ALIYUN_ACCESS_KEY_SECRET",
      "label": "AccessKey Secret",
      "secret": true,
      "required": true,
      "example": ""
    },
    {
      "key": "ALIYUN_SECURITY_TOKEN",
      "label": "STS 临时令牌（使用 STS 凭据时必填）",
      "secret": true,
      "required": false,
      "example": ""
    }
  ],
  "auth": {
    "type": "none"
  },
  "headers": {},
  "tools": [
    {
      "name": "describe_regions",
      "description": "列出可用区域（Action=DescribeRegions，Version=2014-05-26）。连接检测工具，无分页。出处：https://help.aliyun.com/zh/ecs/developer-reference/api-ecs-2014-05-26-describeregions",
      "method": "GET",
      "path": "/",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "describe_instances",
      "description": "分页列出 ECS 实例（Action=DescribeInstances，Version=2014-05-26，RegionId 必填；PageNumber ≥1，PageSize 1-100 官方上限）。出处：https://help.aliyun.com/zh/ecs/developer-reference/api-ecs-2014-05-26-describeinstances",
      "method": "GET",
      "path": "/",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 1,
            "description": "页码（PageNumber）"
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "每页条数（PageSize）"
          }
        },
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "describe_images",
      "description": "分页列出系统自有镜像（Action=DescribeImages，ImageOwnerAlias=self 固定，Version=2014-05-26；PageNumber/PageSize 1-100）。出处：https://help.aliyun.com/zh/ecs/developer-reference/api-ecs-2014-05-26-describeimages",
      "method": "GET",
      "path": "/",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 1,
            "description": "页码（PageNumber）"
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "每页条数（PageSize）"
          }
        },
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    }
  ],
  "limitations": [
    "仅提供所列固定只读查询，不执行任意云 API，也不创建、启停或删除资源。",
    "需要平台账号及对应资源的只读权限；首次连接会实际检查授权。",
    "已按官方接口复核；尚无真实云账号验收，签名与响应测试不能替代实际授权验证。",
    "响应最多 2 MB；分页工具需使用返回的分页参数继续读取。"
  ],
  "docsUrl": "https://www.alibabacloud.com/help/en/sdk/product-overview/v3-request-structure-and-signature"
}
