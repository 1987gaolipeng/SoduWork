{
  "schemaVersion": 1,
  "id": "gmail",
  "name": "Gmail",
  "category": "沟通协作",
  "description": "Gmail 通用连接器：标签列表、邮件列表、邮件详情、发送邮件。基于 Gmail API v1，OAuth 访问令牌由用户安全填入。",
  "officialDocs": [
    "https://developers.google.com/gmail/api/reference/rest/v1/users.labels/list",
    "https://developers.google.com/gmail/api/reference/rest/v1/users.messages/list",
    "https://developers.google.com/gmail/api/reference/rest/v1/users.messages/get",
    "https://developers.google.com/gmail/api/reference/rest/v1/users.messages/send"
  ],
  "authDocs": [
    "https://developers.google.com/gmail/api/auth/about-auth"
  ],
  "baseUrl": "https://gmail.googleapis.com",
  "fields": [
    {
      "key": "GOOGLE_ACCESS_TOKEN",
      "label": "Google OAuth 访问令牌",
      "secret": true,
      "required": true,
      "example": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "tokenKey": "GOOGLE_ACCESS_TOKEN",
    "header": "Authorization",
    "prefix": "Bearer"
  },
  "headers": {},
  "tools": [
    {
      "name": "list_labels",
      "description": "列出用户全部标签。无分页（一次返回全量）。出处：https://developers.google.com/gmail/api/reference/rest/v1/users.labels/list",
      "method": "GET",
      "path": "/gmail/v1/users/me/labels",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "list_messages",
      "description": "列出邮件 ID（按标签/q 过滤）。分页：pageToken + pageSize（1-500 默认 100），响应 nextPageToken。出处：https://developers.google.com/gmail/api/reference/rest/v1/users.messages/list",
      "method": "GET",
      "path": "/gmail/v1/users/me/messages",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label_ids": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "description": "标签 ID"
            }
          },
          "q": {
            "type": "string",
            "description": "Gmail 搜索语法",
            "maxLength": 10000
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "每页条数"
          },
          "page_token": {
            "type": "string",
            "description": "上一页 nextPageToken",
            "maxLength": 10000
          }
        },
        "required": [],
        "maxProperties": 50
      },
      "query": {
        "labelIds": "label_ids",
        "q": "q",
        "maxResults": "max_results",
        "pageToken": "page_token"
      },
      "readOnly": true
    },
    {
      "name": "get_message",
      "description": "获取邮件全文（format 默认 full）。无分页。出处：https://developers.google.com/gmail/api/reference/rest/v1/users.messages/get",
      "method": "GET",
      "path": "/gmail/v1/users/me/messages/{message_id}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{10,}$",
            "description": "邮件 ID",
            "maxLength": 10000
          },
          "format": {
            "type": "string",
            "enum": [
              "full",
              "metadata",
              "minimal",
              "raw"
            ],
            "default": "full",
            "description": "返回格式",
            "maxLength": 10000
          }
        },
        "required": [
          "message_id"
        ],
        "maxProperties": 50
      },
      "query": {
        "format": "format"
      },
      "readOnly": true
    },
    {
      "name": "send_message",
      "description": "发送邮件（POST /send，raw 为 RFC 2822 的 base64url 编码，由运行器编码）。写入操作：运行前必须获得用户明确授权。出处：https://developers.google.com/gmail/api/reference/rest/v1/users.messages/send",
      "method": "POST",
      "path": "/gmail/v1/users/me/messages/send",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$",
            "description": "收件人邮箱",
            "maxLength": 10000
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "主题"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "纯文本正文",
            "maxLength": 10000
          },
          "from": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "description": "已授权 Gmail 账号的发件地址"
          }
        },
        "required": [
          "to",
          "subject",
          "body",
          "from"
        ],
        "maxProperties": 50
      },
      "body": {
        "to": "$to",
        "subject": "$subject",
        "body": "$body",
        "from": "$from"
      },
      "readOnly": false,
      "bodyEncoding": "gmail"
    }
  ],
  "limitations": [
    "静态定义并经格式与来源核验，未做真实连接实测。",
    "访问令牌约 1 小时过期，需用户安全填入并手动更新；自动续期为宿主侧适配项，本连接器未实现。",
    "send_message 的 raw 参数由运行器将 to/subject/body 组装为 RFC 2822 消息后 base64url 编码，不得以明文注入。",
    "发送需要 gmail.send scope，读取需要 gmail.readonly；scope 不足时 API 返回 403。",
    "send_message 为写入操作，必须获得用户明确授权后由运行器执行；本定义不执行任何请求。"
  ]
}
