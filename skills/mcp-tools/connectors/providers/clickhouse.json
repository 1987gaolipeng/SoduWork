{
  "schemaVersion": 1,
  "id": "clickhouse",
  "name": "ClickHouse",
  "category": "数据库",
  "description": "ClickHouse 只读连接器：带身份的常量查询检查、表列表、结构与有界读取；不执行任意 SQL。",
  "runtimeKind": "clickhouse",
  "officialDocs": [
    "https://clickhouse.com/docs/en/interfaces/http",
    "https://clickhouse.com/docs/en/operations/settings/settings#readonly",
    "https://clickhouse.com/docs/en/operations/system-tables/tables",
    "https://clickhouse.com/docs/en/sql-reference/statements/describe-table"
  ],
  "authDocs": [
    "https://clickhouse.com/docs/en/interfaces/http"
  ],
  "baseUrl": "{CH_URL}",
  "fields": [
    {
      "key": "CH_URL",
      "label": "ClickHouse HTTP 端点（仅 https 主机；本机调试允许 http://localhost 或 http://127.0.0.1）",
      "secret": false,
      "required": true,
      "pattern": "^(https://[a-zA-Z0-9][a-zA-Z0-9.-]*(:[0-9]{2,5})?|http://(localhost|127\\.0\\.0\\.1)(:[0-9]{2,5})?)$",
      "example": ""
    },
    {
      "key": "CH_USER",
      "label": "用户名（建议只读账号）",
      "secret": false,
      "required": false,
      "pattern": "^\\S{1,512}$",
      "default": "default",
      "example": ""
    },
    {
      "key": "CH_PASSWORD",
      "label": "密码",
      "secret": true,
      "required": false,
      "example": ""
    },
    {
      "key": "CH_DATABASE",
      "label": "数据库名",
      "secret": false,
      "required": true,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
      "example": ""
    },
    {
      "key": "TLS_CA_PEM",
      "label": "TLS CA PEM（可选，换行写作\\n；远程连接始终校验证书）",
      "secret": false,
      "required": false,
      "example": ""
    }
  ],
  "auth": {
    "type": "none"
  },
  "headers": {},
  "tools": [
    {
      "name": "ping",
      "description": "带配置账号执行 SELECT 1，验证连接与授权；不使用无需授权的 /ping 作为授权依据。",
      "method": "GET",
      "path": "/",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "list_tables",
      "description": "列出当前数据库的表（宿主固定查询 system.tables WHERE database = {db:String}，服务端参数化绑定，readonly=1 + max_result_rows=100）。无分页，最多 100 张。出处：https://clickhouse.com/docs/en/operations/system-tables/tables 支持 offset（0-10000）按表名分页。",
      "method": "GET",
      "path": "/tables",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "每页条数"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "description": "分页偏移；读取数据时必须同时指定唯一的 order_by 字段。并发数据变动可能影响分页。"
          }
        },
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "describe_table",
      "description": "固定查询 system.columns，绑定数据库与表名，最多 100 列。",
      "method": "GET",
      "path": "/tables/{table}/columns",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "description": "表名",
            "maxLength": 256
          }
        },
        "required": [
          "table"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "read_rows",
      "description": "按行读取表数据（宿主固定 SELECT * FROM `db`.`table` LIMIT n FORMAT JSON，readonly=1 强制，limit 1-100，响应 ≤2MB 超出拒绝）。分页：limit（1-100），无游标（未带 ORDER BY，深翻页不适用；建议提供带排序键的只读视图再复核）。出处：https://clickhouse.com/docs/en/interfaces/http",
      "method": "GET",
      "path": "/tables/{table}/rows",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "description": "表名",
            "maxLength": 256
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "读取行数上限"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "description": "分页偏移；读取数据时必须同时指定唯一的 order_by 字段。并发数据变动可能影响分页。"
          },
          "order_by": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "maxLength": 63,
            "description": "用于升序排列的唯一字段，例如主键；offset 大于 0 时必填。"
          }
        },
        "required": [
          "table"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    }
  ],
  "limitations": [
    "所有请求强制 readonly=1 + max_result_rows=100 + result_overflow_mode=throw；只提供宿主固定查询，不执行用户 SQL。",
    "表/列名先过 ^[A-Za-z_][A-Za-z0-9_]{0,62}$ 白名单再以反引号包裹，双层防护。",
    "远程端点必须 https 且始终校验证书（自签名请提供 CA PEM）；仅 http://localhost / http://127.0.0.1 允许本机调试；拒绝重定向。",
    "最多 100 行、响应不超过 2MB；read_rows 不带 ORDER BY，行序不保证，深翻页不适用。",
    "数据分页需指定稳定唯一的 order_by；最多跳过 10000 行。非快照，不保证并发修改期间跨页一致。"
  ]
}
