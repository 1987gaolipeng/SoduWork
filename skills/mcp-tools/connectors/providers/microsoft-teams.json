{
  "schemaVersion": 1,
  "id": "microsoft-teams",
  "name": "Microsoft Teams",
  "category": "沟通协作",
  "description": "Microsoft Teams 通用连接器：我加入的团队与频道列表、频道消息读取、发送消息。基于 Microsoft Graph v1.0，委托式访问令牌由用户安全填入。",
  "officialDocs": [
    "https://learn.microsoft.com/graph/api/user-list-joinedteams",
    "https://learn.microsoft.com/graph/api/team-list-channels",
    "https://learn.microsoft.com/graph/api/channel-list-messages",
    "https://learn.microsoft.com/graph/api/channel-post-messages"
  ],
  "authDocs": [
    "https://learn.microsoft.com/graph/auth/"
  ],
  "baseUrl": "https://graph.microsoft.com/v1.0",
  "fields": [
    {
      "key": "MSFT_ACCESS_TOKEN",
      "label": "Microsoft Graph 访问令牌",
      "secret": true,
      "required": true,
      "example": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "tokenKey": "MSFT_ACCESS_TOKEN",
    "header": "Authorization",
    "prefix": "Bearer"
  },
  "headers": {},
  "tools": [
    {
      "name": "list_joined_teams",
      "description": "列出我加入的团队。分页：@odata.nextLink，可直接跟随。出处：https://learn.microsoft.com/graph/api/user-list-joinedteams",
      "method": "GET",
      "path": "/me/joinedTeams",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "list_team_channels",
      "description": "列出指定团队的频道。分页：@odata.nextLink。出处：https://learn.microsoft.com/graph/api/team-list-channels",
      "method": "GET",
      "path": "/teams/{team_id}/channels",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "team_id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "团队 ID（UUID）",
            "maxLength": 10000
          }
        },
        "required": [
          "team_id"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "list_channel_messages",
      "description": "读取频道消息（不含回复）。分页：@odata.nextLink。应用权限读取需按政策激活，本定义按委托权限。出处：https://learn.microsoft.com/graph/api/channel-list-messages",
      "method": "GET",
      "path": "/teams/{team_id}/channels/{channel_id}/messages",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "team_id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "团队 ID",
            "maxLength": 10000
          },
          "channel_id": {
            "type": "string",
            "pattern": "^(?:19:[A-Za-z0-9_-]+@thread\\.(?:tacv2|skype)|[a-f0-9-]{36}|[0-9]{10,30})$(?![\\s\\S])",
            "description": "频道 ID（使用频道列表返回的原始 ID，例如 19:…@thread.tacv2）",
            "maxLength": 256
          },
          "top": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 50,
            "description": "每页数量"
          },
          "skip_token": {
            "type": "string",
            "maxLength": 8192,
            "description": "上一页 @odata.nextLink 查询参数中的 $skiptoken，按原值传入；没有下一页时不填写"
          }
        },
        "required": [
          "team_id",
          "channel_id"
        ],
        "maxProperties": 50
      },
      "readOnly": true,
      "query": {
        "$top": "top",
        "$skiptoken": "skip_token"
      }
    },
    {
      "name": "send_channel_message",
      "description": "向频道发送消息（POST，body.content 为 HTML）。写入操作：运行前必须获得用户明确授权。出处：https://learn.microsoft.com/graph/api/channel-post-messages",
      "method": "POST",
      "path": "/teams/{team_id}/channels/{channel_id}/messages",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "team_id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "团队 ID",
            "maxLength": 10000
          },
          "channel_id": {
            "type": "string",
            "pattern": "^(?:19:[A-Za-z0-9_-]+@thread\\.(?:tacv2|skype)|[a-f0-9-]{36}|[0-9]{10,30})$(?![\\s\\S])",
            "description": "频道 ID（使用频道列表返回的原始 ID，例如 19:…@thread.tacv2）",
            "maxLength": 256
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "消息 HTML 内容"
          }
        },
        "required": [
          "team_id",
          "channel_id",
          "content"
        ],
        "maxProperties": 50
      },
      "body": {
        "body": {
          "contentType": "html",
          "content": "$content"
        }
      },
      "readOnly": false
    }
  ],
  "limitations": [
    "静态定义并经格式与来源核验，未做真实连接实测。",
    "本定义按委托权限（delegated）建模；应用权限模式读取消息需 Microsoft 政策审批，未覆盖。",
    "访问令牌约 1 小时过期，需用户安全填入并手动更新；自动续期为宿主侧适配项，本连接器未实现。",
    "send_channel_message 为写入操作，必须获得用户明确授权后由运行器执行；本定义不执行任何请求。"
  ]
}
