{
  "schemaVersion": 1,
  "id": "google-drive",
  "name": "Google Drive",
  "category": "云存储",
  "description": "Google Drive 通用连接器：文件列表、文件元信息、上传新文件。基于 Google Drive API v3，OAuth 访问令牌由用户安全填入。",
  "officialDocs": [
    "https://developers.google.com/workspace/drive/api/reference/rest/v3/files/list",
    "https://developers.google.com/workspace/drive/api/reference/rest/v3/files/get",
    "https://developers.google.com/workspace/drive/api/reference/rest/v3/files/create"
  ],
  "authDocs": [
    "https://developers.google.com/workspace/drive/api/guides/api-specific-auth"
  ],
  "baseUrl": "https://www.googleapis.com",
  "fields": [
    {
      "key": "GOOGLE_ACCESS_TOKEN",
      "label": "Google OAuth 访问令牌",
      "secret": true,
      "required": true,
      "example": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "tokenKey": "GOOGLE_ACCESS_TOKEN",
    "header": "Authorization",
    "prefix": "Bearer"
  },
  "headers": {},
  "tools": [
    {
      "name": "list_files",
      "description": "按 q 查询列文件（fields 白名单固定）。分页：pageToken + pageSize（1-1000 默认 100），响应 nextPageToken。出处：https://developers.google.com/workspace/drive/api/reference/rest/v3/files/list",
      "method": "GET",
      "path": "/drive/v3/files",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string",
            "description": "查询语句，如 name contains 'x'",
            "maxLength": 10000
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100,
            "description": "每页条数"
          },
          "page_token": {
            "type": "string",
            "description": "上一页 nextPageToken",
            "maxLength": 10000
          }
        },
        "required": [],
        "maxProperties": 50
      },
      "fixedQuery": {
        "fields": "nextPageToken,files(id,name,mimeType,size,modifiedTime,webViewLink)"
      },
      "query": {
        "q": "q",
        "pageSize": "page_size",
        "pageToken": "page_token"
      },
      "readOnly": true
    },
    {
      "name": "get_file_metadata",
      "description": "获取文件元信息（不含内容下载）。无分页。出处：https://developers.google.com/workspace/drive/api/reference/rest/v3/files/get",
      "method": "GET",
      "path": "/drive/v3/files/{file_id}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{10,}$",
            "description": "文件 ID",
            "maxLength": 10000
          }
        },
        "required": [
          "file_id"
        ],
        "maxProperties": 50
      },
      "fixedQuery": {
        "fields": "id,name,mimeType,size,modifiedTime,webViewLink,owners(displayName)"
      },
      "readOnly": true
    },
    {
      "name": "upload_file",
      "description": "上传 UTF-8 文本文件（≤10,000 字符），不读取本机文件。https://developers.google.com/workspace/drive/api/reference/rest/v3/files/list",
      "method": "POST",
      "path": "/upload/drive/v3/files",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "文件名"
          },
          "mime_type": {
            "type": "string",
            "minLength": 3,
            "description": "MIME 类型",
            "maxLength": 10000,
            "pattern": "^[a-zA-Z0-9.+-]+/[a-zA-Z0-9.+-]+$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "UTF-8 文本内容，最多 10,000 字符，不读取本机文件",
            "maxLength": 10000
          }
        },
        "required": [
          "name",
          "mime_type",
          "content"
        ],
        "maxProperties": 50
      },
      "fixedQuery": {
        "uploadType": "multipart"
      },
      "readOnly": false,
      "bodyEncoding": "drive-multipart",
      "body": {
        "name": "$name",
        "mimeType": "$mime_type",
        "content": "$content"
      }
    }
  ],
  "limitations": [
    "静态定义并经格式与来源核验，未做真实连接实测。",
    "访问令牌约 1 小时过期，需用户安全填入并手动更新；自动续期为宿主侧适配项，本连接器未实现。",
    "upload_file 走 multipart 上传，编码由运行器实现；本定义仅声明参数结构。",
    "upload_file 为写入操作，必须获得用户明确授权后由运行器执行；本定义不执行任何请求。"
  ]
}
