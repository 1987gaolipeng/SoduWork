{
  "schemaVersion": 1,
  "id": "elasticsearch",
  "name": "Elasticsearch",
  "category": "数据库",
  "description": "Elasticsearch 通用连接器：根路径连接检测、索引列表、match_all 固定搜索、按 ID 取文档。不提供任意查询 DSL。",
  "runtimeKind": "elasticsearch",
  "officialDocs": [
    "https://www.elastic.co/guide/en/elasticsearch/reference/current/index.html",
    "https://www.elastic.co/guide/en/elasticsearch/reference/current/cat-indices.html",
    "https://www.elastic.co/guide/en/elasticsearch/reference/current/search-search.html",
    "https://www.elastic.co/guide/en/elasticsearch/reference/current/docs-get.html",
    "https://www.elastic.co/guide/en/elasticsearch/reference/current/http-clients.html"
  ],
  "authDocs": [
    "https://www.elastic.co/guide/en/elasticsearch/reference/current/security-api-create-api-key.html"
  ],
  "baseUrl": "{ES_URL}",
  "fields": [
    {
      "key": "ES_URL",
      "label": "Elasticsearch 基础地址（仅 https 主机；本机调试允许 http://localhost 或 http://127.0.0.1）",
      "secret": false,
      "required": true,
      "pattern": "^(https://[a-zA-Z0-9][a-zA-Z0-9.-]*(:[0-9]{2,5})?|http://(localhost|127\\.0\\.0\\.1)(:[0-9]{2,5})?)$",
      "example": ""
    },
    {
      "key": "ES_USERNAME",
      "label": "用户名（Basic 认证，与 API Key 二选一）",
      "secret": false,
      "required": false,
      "pattern": "^\\S{1,512}$",
      "example": ""
    },
    {
      "key": "ES_PASSWORD",
      "label": "密码（Basic 认证）",
      "secret": true,
      "required": false,
      "example": ""
    },
    {
      "key": "ES_API_KEY",
      "label": "API Key（Authorization: ApiKey <base64>，建议只读权限）",
      "secret": true,
      "required": false,
      "example": ""
    },
    {
      "key": "TLS_CA_PEM",
      "label": "TLS CA PEM（可选，换行写作\\n）",
      "secret": false,
      "required": false,
      "example": ""
    }
  ],
  "auth": {
    "type": "none"
  },
  "headers": {},
  "tools": [
    {
      "name": "ping",
      "description": "连接检测（GET /，返回集群名称、版本等基本信息）。无分页。出处：https://www.elastic.co/guide/en/elasticsearch/reference/current/index.html",
      "method": "GET",
      "path": "/",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "list_indices",
      "description": "列出索引（GET /_cat/indices?format=json，仅返回 health/status/index/docs.count 四列并按索引名排序；无服务端分页，受 2MB 响应上限保护）。出处：https://www.elastic.co/guide/en/elasticsearch/reference/current/cat-indices.html",
      "method": "GET",
      "path": "/_cat/indices",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "search_documents",
      "description": "固定 match_all 查询；from + size 不超过 10000，size 1-100，超时或分片失败不作为成功。此范围之外需缩小索引范围。",
      "method": "POST",
      "path": "/{index}/_search",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,198}$",
            "description": "索引名（不含通配符）",
            "maxLength": 256
          },
          "from": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999,
            "default": 0,
            "description": "起始偏移"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "每页条数"
          }
        },
        "required": [
          "index"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "get_document",
      "description": "按 ID 读取文档（GET /{index}/_doc/{id}）。无分页。出处：https://www.elastic.co/guide/en/elasticsearch/reference/current/docs-get.html",
      "method": "GET",
      "path": "/{index}/_doc/{id}",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,198}$",
            "description": "索引名（不含通配符）",
            "maxLength": 256
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "文档 ID（禁止控制字符）"
          }
        },
        "required": [
          "index",
          "id"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    }
  ],
  "limitations": [
    "search_documents 的查询体固定为 match_all + from/size，不透传任意查询 DSL、脚本与聚合；需要条件查询时请在服务端建只读视图/别名后另行评审。",
    "索引名与文档 ID 先过字符白名单再拼路径，拒绝控制字符与路径穿越（..、/）。",
    "远程端点必须 https 且始终校验证书；仅 http://localhost / http://127.0.0.1 允许本机调试；拒绝重定向；响应 ≤2MB。",
    "Basic 与 API Key 二选一，同时配置会提示修正；提供凭据时使用安全身份端点验证授权。"
  ]
}
