{
  "schemaVersion": 1,
  "id": "ga4",
  "name": "Google Analytics 4",
  "category": "数据分析",
  "description": "Google Analytics 4 Data API 通用连接器：元数据（维度/指标字典）、runReport 报表查询。纯只读，无写入工具；OAuth 访问令牌由用户安全填入。",
  "officialDocs": [
    "https://developers.google.com/analytics/devguides/reporting/data/v1/rest/v1beta/properties/runReport",
    "https://developers.google.com/analytics/devguides/reporting/data/v1/rest/v1beta/properties/getMetadata"
  ],
  "authDocs": [
    "https://developers.google.com/analytics/devguides/reporting/data/v1/rest/v1beta/authorization"
  ],
  "baseUrl": "https://analyticsdata.googleapis.com",
  "fields": [
    {
      "key": "GOOGLE_ACCESS_TOKEN",
      "label": "Google OAuth 访问令牌",
      "secret": true,
      "required": true,
      "example": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "tokenKey": "GOOGLE_ACCESS_TOKEN",
    "header": "Authorization",
    "prefix": "Bearer"
  },
  "headers": {
    "Content-Type": "application/json"
  },
  "tools": [
    {
      "name": "get_metadata",
      "description": "获取属性元数据（可用维度/指标字典，GET /v1beta/properties/{propertyId}/metadata）。无分页。出处：https://developers.google.com/analytics/devguides/reporting/data/v1/rest/v1beta/properties/getMetadata",
      "method": "GET",
      "path": "/v1beta/properties/{property_id}/metadata",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "property_id": {
            "type": "string",
            "pattern": "^[0-9]{6,12}$",
            "description": "GA4 属性 ID（纯数字）",
            "maxLength": 10000
          }
        },
        "required": [
          "property_id"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "run_report",
      "description": "运行报表（POST /v1beta/properties/{propertyId}:runReport，dateRanges + metrics/dimensions 为 [{name}] 数组 $param + offset 分页）。分页：limit/offset 页偏移，响应 rowCount。出处：https://developers.google.com/analytics/devguides/reporting/data/v1/rest/v1beta/properties/runReport",
      "method": "POST",
      "path": "/v1beta/properties/{property_id}:runReport",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "property_id": {
            "type": "string",
            "pattern": "^[0-9]{6,12}$",
            "description": "GA4 属性 ID",
            "maxLength": 10000
          },
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "起始日期 YYYY-MM-DD",
            "maxLength": 10000
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "结束日期 YYYY-MM-DD",
            "maxLength": 10000
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "维度/指标 API 名",
                  "maxLength": 10000
                }
              },
              "required": [
                "name"
              ],
              "maxProperties": 50
            },
            "description": "指标对象数组，如 [{\"name\":\"activeUsers\"}]（官方 runReport 请求结构）"
          },
          "dimensions": {
            "type": "array",
            "minItems": 0,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "维度/指标 API 名",
                  "maxLength": 10000
                }
              },
              "required": [
                "name"
              ],
              "maxProperties": 50
            },
            "description": "维度对象数组，如 [{\"name\":\"date\"}]，可空"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "default": 100,
            "description": "行数上限"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "default": 0,
            "description": "下一页偏移量（与 rowCount/rowCounts 配合翻页）"
          }
        },
        "required": [
          "property_id",
          "start_date",
          "end_date",
          "metrics"
        ],
        "maxProperties": 50
      },
      "body": {
        "dateRanges": [
          {
            "startDate": "$start_date",
            "endDate": "$end_date"
          }
        ],
        "metrics": "$metrics",
        "dimensions": "$dimensions",
        "limit": "$limit",
        "offset": "$offset"
      },
      "readOnly": true
    }
  ],
  "limitations": [
    "静态定义并经格式与来源核验，未做真实连接实测。",
    "metrics/dimensions 按官方 runReport 结构为 [{name:\"…\"}] 对象数组（不经字符串拆分）；名称合法性先经 get_metadata 核对。",
    "访问令牌约 1 小时过期，需用户安全填入并手动更新；自动续期为宿主侧适配项，本连接器未实现。",
    "本连接器为纯只读集合，无写入工具。"
  ]
}
