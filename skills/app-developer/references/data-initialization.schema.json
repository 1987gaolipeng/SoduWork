{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoduWork declarative data initialization",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "migrations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "migrations": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["version", "seed"],
        "properties": {
          "version": {"type": "integer", "minimum": 1, "maximum": 100},
          "seed": {
            "type": "array", "maxItems": 1000,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["collection", "id", "value"],
              "properties": {
                "collection": {"$ref": "#/$defs/key"}, "id": {"$ref": "#/$defs/key"},
                "value": {"type": "object"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$", "not": {"enum": ["__proto__", "prototype", "constructor"]}}
  }
}
