  "locales": {
    "zh-CN": {
      "summary": "改善对话设置、自动化和任务交付体验。",
      "sections": [
        {
          "id": "features",
          "title": "功能更新",
          "items": [
            {
              "id": "directory-preferences",
              "text": "按工作目录记住可用的底座和模型，同一目录新建对话时自动恢复选择。"
            },
            {
              "id": "automation-drafts",
              "text": "自动化支持“五分钟后”等相对时间，并可继续对话修改、确认或取消草稿。"
            }
          ]
        },
        {
          "id": "fixes",
          "title": "问题修复",
          "items": [
            {
              "id": "sign-in-recovery",
              "text": "修复重新打开工作区时登录表单和语言闪动的问题，保留已登录状态与显示偏好。"
            },
            {
              "id": "runner-queue",
              "text": "任务状态显示排队位置和等待时间，并修复多个对话并发时取消操作与执行状态相互干扰的问题。"
            },
            {
              "id": "requirement-delivery",
              "text": "修复需求完成后验收未提交、交付附件遗漏和中间稿混入最终成果的问题。"
            }
          ]
        }
      ]
    },
    "en-US": {
      "summary": "Improved conversation settings, automations and task delivery.",
      "sections": [
        {
          "id": "features",
          "title": "Feature updates",
          "items": [
            {
              "id": "directory-preferences",
              "text": "Working folders remember available runtimes and models, restoring the selection when a new chat starts in the same folder."
            },
            {
              "id": "automation-drafts",
              "text": "Automations accept relative times such as “in five minutes,” and drafts can be revised, confirmed or cancelled through conversation."
            }
          ]
        },
        {
          "id": "fixes",
          "title": "Bug fixes",
          "items": [
            {
              "id": "sign-in-recovery",
              "text": "Fixed sign-in form and language flicker when reopening the workspace, preserving the signed-in state and display preferences."
            },
            {
              "id": "runner-queue",
              "text": "Task status shows queue position and wait time, and concurrent chats no longer interfere with each other’s cancellation or execution status."
            },
            {
              "id": "requirement-delivery",
              "text": "Fixed completed requirements missing acceptance submission or attachments, and intermediate drafts appearing in final deliverables."
            }
          ]
        }
      ]
    },
    "ja-JP": {
      "summary": "会話設定、自動化、タスクの成果物提出を改善しました。",
      "sections": [
        {
          "id": "features",
          "title": "機能更新",
          "items": [
            {
              "id": "directory-preferences",
              "text": "作業フォルダーごとに利用可能な実行エンジンとモデルを記憶し、同じフォルダーで新しいチャットを始めると選択を復元します。"
            },
            {
              "id": "automation-drafts",
              "text": "自動化で「5分後」などの相対時刻を指定でき、会話を続けて下書きの変更、確認、取り消しができます。"
            }
          ]
        },
        {
          "id": "fixes",
          "title": "不具合修正",
          "items": [
            {
              "id": "sign-in-recovery",
              "text": "作業画面を開き直したときのログインフォームや言語表示のちらつきを修正し、ログイン状態と表示設定を保持します。"
            },
            {
              "id": "runner-queue",
              "text": "タスク状態に待ち順と待ち時間を表示し、複数のチャットを同時実行した際にキャンセル操作や実行状態が互いに干渉する問題を修正しました。"
            },
            {
              "id": "requirement-delivery",
              "text": "要件の完了後に検収依頼が提出されない問題、添付ファイルの欠落、途中の下書きが最終成果物に混ざる問題を修正しました。"
            }
          ]
        }
      ]
    },
    "ko-KR": {
      "summary": "대화 설정, 자동화와 작업 결과물 제출을 개선했습니다.",
      "sections": [
        {
          "id": "features",
          "title": "기능 업데이트",
          "items": [
            {
              "id": "directory-preferences",
              "text": "작업 폴더별로 사용 가능한 실행 엔진과 모델을 기억하고 같은 폴더에서 새 대화를 시작하면 선택을 복원합니다."
            },
            {
              "id": "automation-drafts",
              "text": "자동화에 “5분 후” 같은 상대 시간을 지정하고 대화를 이어 가며 초안을 수정, 확인하거나 취소할 수 있습니다."
            }
          ]
        },
        {
          "id": "fixes",
          "title": "버그 수정",
          "items": [
            {
              "id": "sign-in-recovery",
              "text": "작업 공간을 다시 열 때 로그인 양식과 언어 표시가 깜빡이는 문제를 수정하고 로그인 상태와 표시 설정을 유지합니다."
            },
            {
              "id": "runner-queue",
              "text": "작업 상태에 대기 순서와 대기 시간을 표시하고 여러 대화를 동시에 실행할 때 취소 동작과 실행 상태가 서로 간섭하는 문제를 수정했습니다."
            },
            {
              "id": "requirement-delivery",
              "text": "요구사항 완료 후 검수 요청이 제출되지 않거나 첨부 파일이 누락되고 중간 초안이 최종 결과물에 섞이는 문제를 수정했습니다."
            }
          ]
        }
      ]
    }
  },
