{
  "version": 1,
  "apiFamily": "chat-completions",
  "policy": {
    "maxRequests": 7,
    "maxNegotiations": 2,
    "timeoutMs": 30000,
    "totalMs": 120000,
    "maxResponseBytes": 262144,
    "toolChoice": "auto",
    "tool": {
      "type": "function",
      "function": {
        "name": "soduwork_capability_echo",
        "description": "Return a supplied capability-test value without side effects.",
        "parameters": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      }
    },
    "toolPrompt": "Call soduwork_capability_echo with value {{value}}. This is a capability check. After the tool responds, reply only with the tool result value.",
