      "id": "codex",
      "displayName": "Codex",
      "transport": "runner",
      "modelMode": "account",
      "goalMode": "native",
      "group": "more",
      "order": 50,
      "summary": "使用本机 Codex 账号，保留原生规划与执行能力",
      "runner": {
        "adapter": "native"
      },
      "install": {
        "installer": "npm",
        "pkg": "@openai/codex",
        "blurb": "OpenAI 官方 CLI。用它自己的账号（ChatGPT 登录或 OpenAI key），不吃 SoduWork 这边的模型配置。",
        "warn": "这是个人账号版。需要使用企业模型时，请安装旁边的 Codex Harness；企业网关需支持 OpenAI Responses 接口。",
        "config_how": "它自己管登录。没登录过的话，去执行机上跑一次 codex login 按提示登录（或给它环境变量 OPENAI_API_KEY）。个人登录与企业 Codex Harness 完全隔离。",
        "config_path": ""
      }
    },
