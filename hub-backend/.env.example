SODUWORK_ENV=development
# SoduWork Hub environment configuration.
# Copy to .env and supply your values. Never commit secrets; .env is ignored by Git.

# Database.
# SQLite is the default for local development.
DATABASE_URL=sqlite+aiosqlite:///./soduwork_hub.db
#
# Connect to your own PostgreSQL instance:
# Obtain credentials from your secret store or local .env; create the project database first.
# DATABASE_URL=postgresql+asyncpg://<DB_USER>:<PASSWORD>@<PG_HOST>:5432/soduwork_hub
#
# Alternatively, use local Docker PostgreSQL on port 5433 with an explicit POSTGRES_PASSWORD:
# DATABASE_URL=postgresql+asyncpg://soduwork:<PASSWORD>@localhost:5433/soduwork_hub

# Bootstrap an is_super account only when users is empty; later changes here do not update existing accounts.
# Never embed a default password. Development generates an unset password and logs only masked setup information.
# Other environments refuse to start without a password. Use at least 16 random characters or SSO.
ADMIN_USER=admin
ADMIN_PASS=

# Cross-origin resource sharing (CORS).
# Do not use *: unrestricted origins remove this protection for administrative APIs.
# null permits Electron file:// requests, whose Origin header is null.
# localhost:5173 is the hub-frontend Vite development server.
# Use the actual admin origin in production; retain null for desktop access. Same-origin deployments can omit the admin origin.
# CORS_ORIGINS=null,https://hub.example.com
CORS_ORIGINS=null,http://localhost:5173,http://127.0.0.1:5173

# Signing secret for local authentication tokens.
# A leaked secret permits token forgery. Development generates and persists an unset secret in the ignored .auth_secret file.
# Other environments require at least 32 random characters; generate them with secrets.token_urlsafe(48).
# AUTH_SECRET=

# Dedicated read-only stable release feed; empty disables access.
# Generate an independent random token and share only with the catalog consumer.
CLIENT_RELEASE_READ_TOKEN=
# Required when enabling the feed: the public HTTP(S) base URL of your own Hub.
# There is no default hosted service.
HUB_PUBLIC_URL=

OFFLINE_AFTER_SECONDS=30
# Disable for new deployments. Enable only temporarily for legacy-client migration, then disable again.
DEVICE_AUTH_COMPAT=false

# External integration polling.
# Poll enabled integrations with pull adapters every N seconds. Zero disables polling; webhooks and manual pulls remain available.
POLL_INTERVAL_SECONDS=0
# Refresh GitLab/Gerrit repository catalogs every 15 minutes by default; zero disables refresh.
REPOSITORY_SYNC_INTERVAL_SECONDS=900


# GitLab adapter.
# Configure non-secret base_url and project per integration in the admin UI, or set global defaults here.
# GITLAB_BASE_URL=https://gitlab.example.com
# GITLAB_PROJECT=group/subgroup/project        # Project ID or namespaced path.
# Store the PAT only in the ignored .env file, never in source code, the repository, or the database.
# Create a GitLab personal access token under Preferences > Access Tokens; read_api is sufficient for read-only pulls.
GITLAB_TOKEN=
# For internal self-signed GitLab certificates, false disables verification; verification is enabled by default.
# GITLAB_VERIFY_TLS=true

# Task attachment storage: MinIO or S3-compatible storage.
# An unset MINIO_ENDPOINT uses local hub-backend/uploads/ storage for development.
# Otherwise use MinIO. Keep AK/SK credentials in the ignored .env file, outside the database and repository.
# MINIO_ENDPOINT=minio.example.com   # Host only, without a scheme.
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=file-storage
# MINIO_SECURE=true
# ATTACH_MAX_MB=20

# Independent material library storage (user-scoped object prefixes).
# local is the default. remote selects the first complete provider in the order
# below; explicit minio/nfs pins the default. auto uses local only when no remote
# service is configured. The desktop remote tab uses the same ordered selection.
LIBRARY_STORAGE_BACKEND=local
LIBRARY_STORAGE_DIR=uploads/library
LIBRARY_REMOTE_ORDER=minio,nfs
# Only the first completely configured provider is active. An offline active
# provider reports an error: no silent failover to another provider/local disk.
LIBRARY_MINIO_ENDPOINT=
LIBRARY_MINIO_ACCESS_KEY=
LIBRARY_MINIO_SECRET_KEY=
LIBRARY_MINIO_BUCKET=file-storage
LIBRARY_MINIO_SECURE=false
# Direct remote NFS over TCP: server IP/hostname + port + exported directory.
# No local mount/path is needed. export is a path ON THE NFS SERVER.
LIBRARY_NFS_HOST=
LIBRARY_NFS_PORT=2049
LIBRARY_NFS_EXPORT=
# mountd TCP port. 0 discovers it through the server's rpcbind TCP port 111.
LIBRARY_NFS_MOUNT_PORT=0
# Exact protocol: 3 (cross-platform) or 4.1 (Linux/glibc x86_64 Hub).
LIBRARY_NFS_VERSION=3
# v4.1 only: reserved source ports match secure exports; requires bind permission.
LIBRARY_NFS_RESERVED_PORT=true
LIBRARY_NFS_UID=65534
LIBRARY_NFS_GID=65534
LIBRARY_NFS_TIMEOUT=10
# AUTH_SYS UID/GID must have read/write access to the export. Allow the Hub's
# source IP. v3 uses unprivileged client ports (Linux export option: insecure).
# v4.1 defaults to reserved ports; set RESERVED_PORT=false only if the export
# accepts unprivileged ports. Kerberos is not supported by these adapters.
# 0 = unlimited (the default); set a positive value only for a deployment cap.
LIBRARY_MAX_MB=0

# Optional image-to-text adapter. Disabled by default; prefer the selected
# model's declared native image capability. No model is selected implicitly.
# VL_MODEL must name an accessible configured model, or use the explicit pair
# VL_BASE_URL + VL_API_KEY along with VL_MODEL. Never put real keys in this file.
VL_MODEL=
VL_BASE_URL=
VL_API_KEY=


# Optional connector OAuth: all cluster nodes share the secret and a fixed HTTPS HUB_PUBLIC_URL.
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Register HUB_PUBLIC_URL/api/v1/mcp-servers/oauth/callback as the application callback.
# Omit query parameters from callback access logs; they contain one-time authorization codes.
CONNECTOR_OAUTH_KEY=
CONNECTOR_GOOGLE_CLIENT_ID=
CONNECTOR_GOOGLE_CLIENT_SECRET=
CONNECTOR_MICROSOFT_CLIENT_ID=
CONNECTOR_MICROSOFT_CLIENT_SECRET=
CONNECTOR_MICROSOFT_TENANT=organizations
