# Use LF for shell scripts developed on Windows and executed on Linux.
# CRLF shell scripts can fail on Linux with a carriage-return command-not-found error.
# The reported line can obscure the actual line-ending problem.
# hub-backend/installers/runner-install.sh is distributed to Linux hosts.
*.sh text eol=lf
ops/soduworkctl text eol=lf
*.service text eol=lf
*.timer text eol=lf
# Preserve the exact pinned upstream license, including its final blank line.
third-party/licenses/gradle-2.10-LICENSE.txt whitespace=-blank-at-eof
# Preserve whitespace in the verified, unmodified upstream license snapshots.
third-party/licenses/legal-import/duck-LICENSE.txt whitespace=-blank-at-eol
third-party/licenses/legal-import/lop-LICENSE.txt whitespace=-blank-at-eol
third-party/licenses/legal-import/mammoth-LICENSE.txt whitespace=-blank-at-eol
third-party/licenses/legal-import/option-LICENSE.txt whitespace=-blank-at-eol
third-party/licenses/legal-import/inherits-LICENSE.txt whitespace=-blank-at-eof
third-party/licenses/legal-import/string_decoder-LICENSE.txt whitespace=-blank-at-eof
# This generated copy retains literal template-string whitespace from the
# pinned desktop highlight.js bundle; byte identity is checked by the builder.
mobile/assets/shared-conversation/pc/vendor/markdown/highlight.min.js whitespace=-blank-at-eol
# Native WebView assets are reviewed byte-for-byte across Windows and Unix.
# Keep canonical generated text in LF while leaving binary assets unchanged.
mobile/assets/shared-conversation/**/*.js text eol=lf
mobile/assets/shared-conversation/**/*.css text eol=lf
mobile/assets/shared-conversation/**/*.html text eol=lf
mobile/assets/shared-conversation/**/*.json text eol=lf
mobile/assets/shared-conversation/**/*.svg text eol=lf
mobile/assets/shared-conversation/**/*.md text eol=lf
mobile/assets/shared-conversation/**/*.txt text eol=lf
mobile/assets/shared-conversation/**/LICENSE.* text eol=lf
mobile/assets/shared-conversation/**/*.png -text
